# Database Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Payment Gateway Selector ('xendit' atau 'midtrans')
PAYMENT_GATEWAY=xendit

# Konfigurasi Xendit (Rekomendasi)
# Ambil dari: Dashboard Xendit -> Settings -> API Keys & Webhooks
XENDIT_SECRET_KEY=xnd_development_your_secret_key_here
XENDIT_CALLBACK_TOKEN=your_callback_verification_token_here

# Konfigurasi Midtrans (Alternatif)
# Ambil dari: Dashboard Midtrans -> Settings -> Access Keys
MIDTRANS_SERVER_KEY=your_server_key_here
MIDTRANS_CLIENT_KEY=your_client_key_here
MIDTRANS_IS_PRODUCTION=false
